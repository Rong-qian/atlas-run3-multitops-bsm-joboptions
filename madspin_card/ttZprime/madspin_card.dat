 set max_weight_ps_point 450  # number of PS to estimate the maximum for each event
 set BW_cut 15
 set seed 202411
 define wdec = e+ mu+ ta+ e- mu- ta- ve vm vt ve~ vm~ vt~ g u c d s b u~ c~ d~ s~ b~
 decay t > w+ b, w+ > wdec wdec
 decay t~ > w- b~, w- > wdec wdec
 decay w+ > wdec wdec
 decay w- > wdec wdec 
 launch